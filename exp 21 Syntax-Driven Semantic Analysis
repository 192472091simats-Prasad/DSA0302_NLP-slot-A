import spacy

nlp = spacy.load("en_core_web_sm")

sentence = "The student reads a book."

doc = nlp(sentence)

for chunk in doc.noun_chunks:
    print("Noun Phrase:", chunk.text)

    root = chunk.root
    print("Meaning:", root.lemma_)
    Output:

Noun Phrase: The student
Meaning: student


Noun Phrase: a book
Meaning: book
