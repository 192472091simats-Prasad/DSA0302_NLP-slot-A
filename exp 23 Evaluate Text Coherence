import re

text = """
Machine learning is a branch of artificial intelligence.
Machine learning algorithms learn from data.
Data is used to train machine learning models.
"""

sentences = [s.strip() for s in text.strip().split(".") if s.strip()]

score = 0

for i in range(len(sentences) - 1):
    words1 = set(re.findall(r'\w+', sentences[i].lower()))
    words2 = set(re.findall(r'\w+', sentences[i + 1].lower()))

    common = words1.intersection(words2)

    if common:
        score += 1

coherence = score / (len(sentences) - 1)

print("Coherence Score:", coherence)

if coherence > 0.5:
    print("Text is coherent")
else:
    print("Text is less coherent")


