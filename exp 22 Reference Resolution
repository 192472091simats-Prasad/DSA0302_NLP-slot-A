import spacy

nlp = spacy.load("en_core_web_sm")

text = "Ravi went to the library. He borrowed a book."

doc = nlp(text)

last_person = None

for token in doc:
    if token.ent_type_ == "PERSON":
        last_person = token.text

    if token.text.lower() == "he" and last_person:
        print("Reference:", token.text)
        print("Resolved to:", last_person)

        Output:

Reference: He
Resolved to: Ravi
